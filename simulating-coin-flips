import random

playing = True

def coin_flip():
  val = random.randint(0,1)
  if val == 0:
    return "Tails"
  else:
    return "Heads"

print("Welcome, first coin toss incoming")

while playing:
  print("flipping...")
  print(f"It's {coin_flip()}")
  continuePlaying = input("Would you like to continue playing? (Y/N): ")
  playing = False

  while continuePlaying.upper() not in ("Y", "N"):
    print("Invalid input. Please enter Y or N.")
    continuePlaying = input("Would you like to continue playing? (Y/N): ")

  if continuePlaying.upper() == "N":
    playing = False
